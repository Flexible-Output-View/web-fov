# =============================================================
# FOV-WEB MASTER ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your local values.
# =============================================================

# --- DATABASE CONFIGURATION ---
# Root password for the MySQL container
DB_PASSWORD=your_secure_db_password_here

# --- BACKEND SPECIFIC ---
# The public hostname for the API (e.g., api.example.com), only if deployed
# API_HOSTNAME=localhost

# The endpoint hostname for SRT streaming (e.g., api.example.com or localhost)
SRT_URL=localhost

# --- FRONTEND BUILD ARGUMENTS ---
# The full URL to your backend API (e.g., http://localhost:4000/api)
API_URL=http://localhost:4000/api

# Twitch API Credentials (Public Client ID)
TWITCH_ID=your_twitch_client_id_here

# Twitch API Credentials (Private Secret) TODO: Move this to backend
TWITCH_SECRET=your_twitch_client_secret_here