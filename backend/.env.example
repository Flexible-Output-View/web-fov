PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=examplepassword
DB_NAME=fovwebdb
# Must point to an FFmpeg build with SRT support.
# macOS: brew install ffmpeg-full && FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# Linux: distro FFmpeg packages usually include SRT, so `ffmpeg` is enough.
FFMPEG_PATH=ffmpeg
MEDIA_ROOT=./media
TWITCH_CLIENT_ID=YOUR_CLIENT_ID_HERE
TWITCH_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
MOQ_URL=http://localhost
MOQ_PORT=4443