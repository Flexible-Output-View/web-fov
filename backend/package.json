{
    "name": "fov-backend",
    "version": "0.1.0",
    "description": "FOV backend (Express)",
    "type": "module",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "test:integration": "sh -c 'if [ \"${CI:-}\" = \"true\" ]; then npm run test:integration:raw; else ./run-integration-tests.sh; fi'",
        "test:integration:raw": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand postgres.integration.test.js",
        "test:watch": "jest --watch",
        "lint": "eslint src/ --ext .js,.mjs",
        "lint:fix": "eslint src/ --ext .js,.mjs --fix"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.0.0",
        "express": "^4.22.1",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.0",
        "node-fetch": "^3.3.2",
        "pg": "^8.23.0",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.11",
        "supertest": "^6.3.3",
        "@jest/globals": "^30.5.2"
    },
    "engines": {
        "node": ">=22.12.0 <23",
        "npm": ">=10 <11"
    }
}